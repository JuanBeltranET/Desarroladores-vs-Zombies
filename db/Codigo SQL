-- Código SQL:
CREATE DATABASE zombie_escape;

USE zombie_escape;

create table Datos_de_usuario(
    id_players int AUTO_INCREMENT,
    PRIMARY KEY (id_players),
    nombre varchar (50) NOT null,
    habilidad varchar (50) NOT null,
    nivel INT NOT null,
    fecha_nacimiento DATE NOT NULL,
    fecha_ingreso DATE NOT NULL
);
    
CREATE TABLE Partidas(
    id_Partidas INT AUTO_INCREMENT,
    PRIMARY KEY (id_Partidas),
    fecha_fin DATE NOT NULL,
    fecha_inicio DATE NOT NULL,
    tiempo_supervivencia INT NOT NULL,
    dificultad_inicial VARCHAR(50) NOT null,
    id_players int not null,
    FOREIGN KEY (id_players) REFERENCES Datos_de_usuario(id_players)
);
        
CREATE TABLE Catálogo_de_zombies(
    zombie_type_id int AUTO_INCREMENT,
    PRIMARY KEY (zombie_type_id),
    vida_base int not null,
    tipo_movimiento varchar (50) not null,
    daño int not null,
    nombre varchar (50) not null,
    velocidad varchar (50) not null
);
            
CREATE TABLE Instancias_Activas_por_Sesion(
    id_ZombieInstances INT AUTO_INCREMENT,
    PRIMARY KEY (id_ZombieInstances),
    x INT NOT null,
    y INT NOT null,
    estado varchar (50),
    vida_actual int not null,
    id_Partidas int not null,
    FOREIGN KEY (id_Partidas) REFERENCES Partidas(id_Partidas),
    zombie_type_id int not null,
    FOREIGN KEY (zombie_type_id) REFERENCES Catálogo_de_zombies(zombie_type_id)
);
                
CREATE TABLE Registro_de_Daño_Recibido(
    id_damage_log int AUTO_INCREMENT,
    PRIMARY KEY (id_damage_log),
    valor_daño int not null,
    zona_impacto varchar (50) not null,
    id_zombie int not null,
    `timestamp` INT NOT NULL,
    FOREIGN KEY (id_zombie) REFERENCES Catálogo_de_zombies(zombie_type_id),
    id_Partidas int not null,
    FOREIGN KEY (id_Partidas) REFERENCES Partidas(id_Partidas)
);
               
CREATE TABLE Registro_de_encuentros_jugador_zombie(
    id_encounters INT AUTO_INCREMENT,
    PRIMARY KEY (id_encounters),
    distancia_inicial int NOT null,
    resultado varchar (50) NOT null,
    `timestamp` INT NOT NULL,
    id_Partidas int not null,
    FOREIGN KEY (id_Partidas) REFERENCES Partidas(id_Partidas),
    id_zombie int not null,
    FOREIGN KEY (id_zombie) REFERENCES Catálogo_de_zombies(zombie_type_id)
);
    
CREATE TABLE Acciones_del_Jugador(
    id_actions int AUTO_INCREMENT,
    PRIMARY KEY (id_actions),
    `timestamp` int not null,
    tipo_accion varchar (50) not null,
    recurso_usado int not null,
    coordenadas int not null,
    id_Partidas int not null,
    FOREIGN KEY (id_Partidas) REFERENCES Partidas(id_Partidas)
);
        
create table Estado_final_de_la_partida(
    id_game_state INT AUTO_INCREMENT,
    PRIMARY KEY (id_game_state),
    puntaje_final int not null,
    motivo_fin varchar (50) not null,
    zombies_eliminados int not null,
    recursos_restantes int not null,
    id_Partidas int not null,
    FOREIGN KEY (id_Partidas) REFERENCES Partidas(id_Partidas)
);

